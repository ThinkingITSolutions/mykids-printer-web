# Copie para .env (docker compose) ou cadastre no Coolify.
# Gere com: openssl rand -hex 32  — NÃO troque depois (cifra a senha da conta MyKids).
APP_SECRET=
PORT=8080
# true somente com HTTPS na frente
SECURE_COOKIES=false
# HTTPS direto no app (opcional, alternativa ao Traefik): caminhos PEM montados no container
# TLS_CERT_FILE=/certs/fullchain.pem
# TLS_KEY_FILE=/certs/privkey.pem
